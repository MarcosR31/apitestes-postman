    {
      "name": "Cadastro de Produto",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "",
              "// 1. Status code",
              "pm.test(\"Produto é criado com sucesso\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "// 2. Content-Type header",
              "pm.test(\"Produto apresenta conteúdo em formato JSON\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "// 3. Response time",
              "pm.test(\"Produto é criado em menos de 5000 milissegundos\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(5000);",
              "});",
              "",
              "// 4. Body has data object",
              "pm.test(\"Produto apresenta as informações cadastradas\", function () {",
              "    pm.expect(jsonData).to.have.property(\"data\");",
              "    pm.expect(jsonData.data).to.be.an(\"object\");",
              "});",
              "",
              "// 5. data.id is a positive number",
              "pm.test(\"Produto apresenta identificador numérico positivo\", function () {",
              "    pm.expect(jsonData.data).to.have.property(\"id\");",
              "    pm.expect(jsonData.data.id).to.be.a(\"number\");",
              "    pm.expect(jsonData.data.id).to.be.above(0);",
              "});",
              "",
              "// 6. data.name is a string",
              "pm.test(\"Produto apresenta nome preenchido\", function () {",
              "    pm.expect(jsonData.data).to.have.property(\"name\");",
              "    pm.expect(jsonData.data.name).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "// 7. data.slug is a string",
              "pm.test(\"Produto apresenta endereço de identificação preenchido\", function () {",
              "    pm.expect(jsonData.data).to.have.property(\"slug\");",
              "    pm.expect(jsonData.data.slug).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "// 8. data.price is a positive number",
              "pm.test(\"Produto apresenta preço com valor positivo\", function () {",
              "    pm.expect(jsonData.data).to.have.property(\"price\");",
              "    pm.expect(jsonData.data.price).to.be.a(\"number\");",
              "    pm.expect(jsonData.data.price).to.be.above(0);",
              "});",
              "",
              "// 9. data.stock_quantity is a non-negative number",
              "pm.test(\"Produto apresenta quantidade em estoque com valor não negativo\", function () {",
              "    pm.expect(jsonData.data).to.have.property(\"stock_quantity\");",
              "    pm.expect(jsonData.data.stock_quantity).to.be.a(\"number\");",
              "    pm.expect(jsonData.data.stock_quantity).to.be.at.least(0);",
              "});",
              "",
              "// 10. data.sku is a string",
              "pm.test(\"Produto apresenta código de identificação preenchido\", function () {",
              "    pm.expect(jsonData.data).to.have.property(\"sku\");",
              "    pm.expect(jsonData.data.sku).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "// 11. data.category_id is a number",
              "pm.test(\"Produto apresenta categoria com identificador numérico\", function () {",
              "    pm.expect(jsonData.data).to.have.property(\"category_id\");",
              "    pm.expect(jsonData.data.category_id).to.be.a(\"number\");",
              "});",
              "",
              "// 12. data.supplier_id is a number",
              "pm.test(\"Produto apresenta fornecedor com identificador numérico\", function () {",
              "    pm.expect(jsonData.data).to.have.property(\"supplier_id\");",
              "    pm.expect(jsonData.data.supplier_id).to.be.a(\"number\");",
              "});",
              "",
              "// 13. data.is_active is boolean true",
              "pm.test(\"Produto apresenta situação ativa\", function () {",
              "    pm.expect(jsonData.data).to.have.property(\"is_active\");",
              "    pm.expect(jsonData.data.is_active).to.be.true;",
              "});",
              "",
              "// 14. data.created_at is a valid date string",
              "pm.test(\"Produto apresenta data de criação válida\", function () {",
              "    pm.expect(jsonData.data).to.have.property(\"created_at\");",
              "    pm.expect(new Date(jsonData.data.created_at).toString()).to.not.equal(\"Invalid Date\");",
              "});",
              "",
              "// 15. mensagens array exists and contains success message",
              "pm.test(\"Produto apresenta mensagem de criação realizada com sucesso\", function () {",
              "    pm.expect(jsonData).to.have.property(\"mensagens\");",
              "    pm.expect(jsonData.mensagens).to.be.an(\"array\").that.is.not.empty;",
              "    pm.expect(jsonData.mensagens[0]).to.include(\"Produto criado com sucesso!\");",
              "});",
              "",
              "// 16. Save produtoId to environment variable",
              "pm.environment.set(\"produtoId\", jsonData.data.id);",
              "pm.test(\"Produto apresenta identificador disponível para utilização posterior\", function () {",
              "    pm.expect(pm.environment.get(\"produtoId\")).to.equal(jsonData.data.id);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
