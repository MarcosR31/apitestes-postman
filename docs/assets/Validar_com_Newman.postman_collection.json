    {
      "name": "Validar cadastro de categoria",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Validar Status Code 201",
              "pm.test(\"Categoria é criada com sucesso\", function () {",
              "    pm.expect(pm.response.code).to.equal(201);",
              "});",
              "",
              "// 2. Validar que o campo \"name\" não está vazio",
              "pm.test(\"Categoria apresenta nome preenchido\", function () {",
              "    const responseData = pm.response.json();",
              "    pm.expect(responseData.data).to.have.property('name');",
              "    pm.expect(responseData.data.name).to.not.be.empty;",
              "    pm.expect(typeof responseData.data.name).to.equal('string');",
              "});",
              "",
              "// 3. Validar que o campo \"description\" não está vazio",
              "pm.test(\"Categoria apresenta descrição preenchida\", function () {",
              "    const responseData = pm.response.json();",
              "    pm.expect(responseData.data).to.have.property('description');",
              "    pm.expect(responseData.data.description).to.not.be.empty;",
              "    pm.expect(typeof responseData.data.description).to.equal('string');",
              "});",
              "",
              "// 4. Validar que o array \"mensagens\" contém a mensagem esperada",
              "pm.test(\"Categoria apresenta mensagem de criação realizada com sucesso\", function () {",
              "    const responseData = pm.response.json();",
              "    pm.expect(responseData).to.have.property('mensagens');",
              "    pm.expect(responseData.mensagens).to.be.an('array');",
              "    pm.expect(responseData.mensagens).to.include('Categoria criada com sucesso!');",
              "});",
              "",
              "// 5. Validar que o campo \"is_active\" é true",
              "pm.test(\"Categoria apresenta situação ativa\", function () {",
              "    const responseData = pm.response.json();",
              "    pm.expect(responseData.data).to.have.property('is_active');",
              "    pm.expect(responseData.data.is_active).to.be.true;",
              "});",
              "",
              "// 6. Validar que o campo \"id\" é um número positivo",
              "pm.test(\"Categoria apresenta identificador numérico positivo\", function () {",
              "    const responseData = pm.response.json();",
              "    pm.expect(responseData.data).to.have.property('id');",
              "    pm.expect(responseData.data.id).to.be.a('number');",
              "    pm.expect(responseData.data.id).to.be.greaterThan(0);",
              "});",
              "",
              "// 7. Validar que o campo \"slug\" é uma string válida (não vazia)",
              "pm.test(\"Categoria apresenta endereço de identificação preenchido\", function () {",
              "    const responseData = pm.response.json();",
              "    pm.expect(responseData.data).to.have.property('slug');",
              "    pm.expect(responseData.data.slug).to.be.a('string');",
              "    pm.expect(responseData.data.slug).to.not.be.empty;",
              "});",
              "",
              "// 9. Validar que o Response Time é menor que 200ms",
              "pm.test(\"Categoria é criada em menos de 200 milissegundos\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(200);",
              "});",
              "",
              "// 10. Validar a estrutura completa da resposta",
              "pm.test(\"Categoria apresenta todas as informações obrigatórias\", function () {",
              "    const responseData = pm.response.json();",
              "    ",
              "    // Validar estrutura raiz",
              "    pm.expect(responseData).to.have.property('data');",
              "    pm.expect(responseData).to.have.property('mensagens');",
              "    ",
              "    // Validar campos dentro de 'data'",
              "    pm.expect(responseData.data).to.have.property('id');",
              "    pm.expect(responseData.data).to.have.property('name');",
              "    pm.expect(responseData.data).to.have.property('slug');",
              "    pm.expect(responseData.data).to.have.property('description');",
              "    pm.expect(responseData.data).to.have.property('is_active');",
              "    pm.expect(responseData.data).to.have.property('created_at');",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
