          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseURL}}/products",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "products"
          ]
        }
      },
      "response": []
